# surmem CMS 后端（Spring Boot + JPA + Flyway + MySQL）环境变量示例
# ---------------------------------------------------------------------------
# 本文件只列出键名与用途，不含任何真实值，可安全提交/分享。
# 这些变量必须在应用启动前由环境提供；缺少任何一个，应用都会因占位符无法
# 解析（Could not resolve placeholder）而启动失败。
# ---------------------------------------------------------------------------

# 数据源 URL（对应 spring.datasource.url）
DB_URL=

# 数据库用户名（对应 spring.datasource.username）
DB_USERNAME=

# 数据库密码（对应 spring.datasource.password）
DB_PASSWORD=

# JWT 签名密钥（对应 app.security.jwt-secret）
AROMEM_JWT_SECRET=
